# Copy this file to .env.local, then run `neon env pull` for live Neon credentials.
# Never commit .env.local; Neon injects database, auth, and S3 credentials there.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"

# Neon Auth values are supplied by `neon deploy`.
NEON_AUTH_BASE_URL=""
NEON_AUTH_JWKS_URL=""

# Used to grant the initial platform-admin role after Neon verifies this email.
OWNER_EMAIL=""

# Optional application port; defaults to 3000.
PORT=3000

# Object Storage variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_ENDPOINT_URL_S3, AWS_REGION) are injected by `neon deploy`.
# The private bucket configured in neon.ts is named "assets".
