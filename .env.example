# Required: MySQL-compatible database used by the server and Drizzle migrations.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/borewatch"

# Optional: this account is granted the initial administrator role when created.
OWNER_EMAIL=""

# Optional: application server port (defaults to 3000).
PORT=3000

# Optional: required only when using the configured Forge file-storage integration.
FORGE_API_URL=""
FORGE_API_KEY=""
